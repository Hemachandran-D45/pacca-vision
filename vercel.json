{
  "buildCommand": "npm install -g pnpm && pnpm install && pnpm run build",
  "outputDirectory": "dist/public",
  "installCommand": "npm install -g pnpm && pnpm install",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/senderra/:path*",
      "destination": "/api/senderra/[...route]"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 120
    }
  }
}
