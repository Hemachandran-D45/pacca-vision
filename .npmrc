# PRECAUTIONARY, not a fix for any observed failure.
#
# Vercel's serverless builder traces imports and COPIES the files it finds; it
# does not bundle. pnpm's default node_modules is a tree of symlinks into
# .pnpm/, and whether that survives the copy for a deep transitive graph like
# @azure/cosmos is untested here - the function that was failing died on its own
# relative import long before it ever reached the SDK, so we never found out.
#
# A hoisted linker produces the flat, npm-shaped tree the tracer expects. It
# costs some disk and install time and has no functional downside, so it stays
# as insurance. Verified: the unbundled function resolves under BOTH layouts
# locally, so this can be deleted if you want a smaller install.
node-linker=hoisted
