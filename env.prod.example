# Production configuration for ca-pacca-idp-web (Azure Container Apps, pacca-idp-rg).
#
#   cp env.prod.example .env.prod        # .env.prod is gitignored and kept out of the image
#   bash scripts/deploy/prod-config.sh secrets   # push the 7 secrets to Key Vault
#   bash scripts/deploy/prod-config.sh apply     # wire secrets + settings into the container app
#
# These are PRODUCTION values (senderra-idp-rg). Your .env points at the TEST resources
# (pacca-vision-rg); do not copy Cosmos, storage or function values from it.
# What each variable does: docs/deploy/03_secrets_and_env.md

# --- Plain settings: set directly on the container --------------------------------------
COSMOS_ENDPOINT=https://cosmos-senderra-idp.documents.azure.com:443/
COSMOS_DATABASE=senderra-idp
COSMOS_CONTAINER=documents
AZURE_STORAGE_ACCOUNT=senderraidpsa
AZURE_FILES_SHARE_NAME=senderra-idp-share
SENDERRA_DOCS_CONTAINER=docs-in
SENDERRA_UPLOAD_RUN_ID=ui
SENDERRA_FUNCTION_URL=https://func-senderra-idp-001-hadkerc7ggh3b3g5.eastus-01.azurewebsites.net
OPENAI_BASE_URL=https://senderra-idp-fr.openai.azure.com/openai/deployments/gpt-5.6-luna
OPENAI_MODEL=gpt-5.6-luna
OPENAI_API_VERSION=2024-06-01
OPENAI_AUTH_HEADER=api-key
# true lets staff place REAL IVR outreach calls from production; false hides the button.
PACCA_IVR_TRIGGER_ENABLED=true
IVR_TRIGGER_URL=https://32-198-146-206.sslip.io/idp/trigger-outreach
IVR_TRIGGER_TIMEOUT=10

# --- Secrets: pushed to Key Vault kv-pacca-idp-web, referenced by the container ----------
# Leave a value EMPTY and `prod-config.sh secrets` fills it for you:
#   COSMOS_KEY, AZURE_STORAGE_KEY (key2), OPENAI_API_KEY (key2), SENDERRA_FUNCTION_KEY
#       -> read from Azure straight into Key Vault; the value never touches disk
#   PACCA_JWT_SECRET, IVR_WRITEBACK_API_KEY
#       -> generated once; an existing Key Vault value is kept on later runs
# IVR_API_KEY cannot be looked up (it belongs to the IVR backend): copy it from your .env.
COSMOS_KEY=
AZURE_STORAGE_KEY=
OPENAI_API_KEY=
SENDERRA_FUNCTION_KEY=
IVR_API_KEY=
IVR_WRITEBACK_API_KEY=
PACCA_JWT_SECRET=
