# PACCA Vision Environment Variables
# Copy this to .env.local and fill in the values

# GitHub solution commits (server only — never prefix with VITE_)
GITHUB_TOKEN=github_pat_replace_me
GITHUB_REPO=https://github.com/Chegu-Pavanaditya-Sairam/senderra-idp-sol.git
GITHUB_BRANCH=main
GITHUB_SOLUTIONS_DIR=analyzers/out
GITHUB_COMMIT_MESSAGE=Add solution from PACCA Vision
# Optional GitHub Enterprise API root
# GITHUB_API_URL=https://api.github.com

# Chat Completions (server only — the model output is what gets committed)
OPENAI_API_KEY=sk-replace-me
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# Azure: OPENAI_BASE_URL=https://YOUR_RESOURCE.openai.azure.com/openai/deployments/YOUR_DEPLOYMENT
# Azure: OPENAI_API_VERSION=2024-06-01
# Azure: OPENAI_AUTH_HEADER=api-key
# SOLUTION_PROMPT_TEMPLATE=server/prompts/create-solution.txt

# OAuth Portal Configuration
VITE_OAUTH_PORTAL_URL=https://your-oauth-portal.com
VITE_APP_ID=your-app-id-here

# Analytics (Umami)
VITE_ANALYTICS_ENDPOINT=https://analytics.example.com
VITE_ANALYTICS_WEBSITE_ID=your-website-id

# Optional: If using Forge Storage
BUILT_IN_FORGE_API_URL=https://api.forge.example.com
BUILT_IN_FORGE_API_KEY=your-forge-api-key

# =============================================================================
# Senderra IDP pipeline — Cosmos DB + Blob Storage
# =============================================================================
# All server-only. NEVER prefix any of these with VITE_: Vite inlines VITE_*
# into the browser bundle and these are account keys.
#
# In Vercel: Project → Settings → Environment Variables, or run
#   bash scripts/vercel-env.sh
# which pushes every value below from your local .env.local.

# --- Cosmos DB (the pipeline's queryable projection) ---
# Portal: cosmos-senderra-idp → Settings → Keys → URI and PRIMARY KEY.
# Use PRIMARY KEY, not PRIMARY CONNECTION STRING — the SDK wants the bare key.
COSMOS_ENDPOINT=https://cosmos-senderra-idp.documents.azure.com:443/
COSMOS_KEY=replace-me
COSMOS_DATABASE=senderra-idp
COSMOS_CONTAINER=documents

# --- Blob storage (upload intake + source-PDF reads) ---
# Portal: senderraidpsa → Access keys → key1. The account key is needed to MINT
# the SAS tokens; it is never sent to the browser — only the scoped, 15-minute,
# single-blob token is.
AZURE_STORAGE_ACCOUNT=senderraidpsa
AZURE_STORAGE_KEY=replace-me

# The pipeline's intake container. A blob write here IS the trigger — Event Grid
# fires and stage 1 begins. There is no processing API to call.
SENDERRA_DOCS_CONTAINER=docs-in

# First path segment for documents uploaded from this app, which becomes the
# run id and the Cosmos partition-key prefix. Keep it distinct from benchmark
# runs (r000-…, r004-…) so demo traffic stays separable from benchmark data.
SENDERRA_UPLOAD_RUN_ID=ui
